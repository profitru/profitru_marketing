# Copy to .env and fill in your SMTP details.
# Run the site + API: python contact_server.py

# --- SMTP (required for /api/contact) ---
# If support@ gets Microsoft error 550 5.1.8 AS(42004), switch SMTP_USER to an unblocked mailbox (e.g. founder@).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=founder@profitru.com
SMTP_PASSWORD=your-app-password

# Use STARTTLS (typical for port 587). Set false only if your host uses plain SMTP on a private network.
SMTP_USE_TLS=true

# Set true for implicit TLS on port 465 (SMTP_SSL). If true, STARTTLS above is ignored.
SMTP_USE_SSL=false

# Who receives contact + waitlist notifications (use a different mailbox than SMTP_USER when possible).
CONTACT_TO_EMAIL=founder@profitru.com

# Optional override for waitlist only (defaults to CONTACT_TO_EMAIL, then founder@profitru.com).
WAITLIST_TO_EMAIL=founder@profitru.com

# Send thank-you emails to users after successful submit (enable after SMTP tests pass).
# Put comments on their own line — systemd EnvironmentFile does not support inline # comments.
WAITLIST_SEND_ACK=true
CONTACT_SEND_ACK=true

# --- Form abuse protection (recommended in production) ---
# Emergency kill switch for all form email:
# FORM_SUBMISSIONS_ENABLED=false

# Cloudflare Turnstile (https://dash.cloudflare.com/) — set both keys to require CAPTCHA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
FORM_REQUIRE_TURNSTILE=true
FORM_REQUIRE_NONCE=true
FORM_REQUIRE_BROWSER_HEADERS=true

# Rate limits (per client IP, rolling window)
FORM_RATE_LIMIT_WINDOW_SEC=3600
FORM_RATE_LIMIT_MAX_CONTACT=1
FORM_RATE_LIMIT_MAX_WAITLIST=1
FORM_GLOBAL_RATE_LIMIT_WINDOW_SEC=3600
FORM_GLOBAL_RATE_LIMIT_MAX=2
FORM_MIN_FILL_SECONDS=8

# Envelope "From" address (must match SMTP_USER for Office 365).
CONTACT_FROM_EMAIL=founder@profitru.com

# Server bind (optional)
CONTACT_SERVER_HOST=127.0.0.1
CONTACT_SERVER_PORT=8080
